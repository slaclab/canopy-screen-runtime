# Copy to .env.local and adjust. See README.md for details.

# Base URL serving a canopy-screens checkout (manifest.json + screens/**).
# Empty = same origin.
VITE_SCREENS_BASE_URL=http://localhost:8123

# mock (default) | hare
VITE_PV_MODE=mock

# edm (default) | carbon — how screens present alarms and text metrics.
# A screen URL's ?render=edm|carbon overrides it per page.
#VITE_RENDER_MODE=edm

# Only used when VITE_PV_MODE=hare:
#VITE_CANOPY_BASE_URL=https://canopy.example.org
#VITE_CANOPY_API_KEY=changeme

# Legacy EDM screens rendered directly at /edl/<path>?MACRO=value: the
# display-file endpoint ({base}/files/<path>, {base}/config/colors.list).
#VITE_EDM_BASE_URL=http://127.0.0.1:8140/displays/v1
