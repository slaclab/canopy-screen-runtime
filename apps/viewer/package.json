{
  "name": "viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Canopy Screens — the operator-facing viewer for canopy-screens content",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:fixtures": "node scripts/check-fixture-copies.mjs"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.83.0",
    "@carbon/react": "^1.108.0",
    "@carbon/styles": "^1.100.0",
    "@slaclab/canopy-client": "^0.3.1-als.1",
    "@slaclab/canopy-dock-engine": "workspace:^",
    "@slaclab/canopy-react": "^0.3.1-als.1",
    "@slaclab/canopy-screen-ir": "^0.3.1-als.1",
    "@slaclab/canopy-screen-runtime": "workspace:^",
    "@slaclab/canopy-screen-widgets": "workspace:^",
    "@slaclab/canopy-shell": "^0.3.1-als.1",
    "dockview-core": "7.0.2",
    "modern-screenshot": "^4.7.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@ibm/plex-mono": "^1.1.0",
    "@ibm/plex-sans": "^1.1.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.6",
    "jsdom": "^26.0.0",
    "sass": "^1.101.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
