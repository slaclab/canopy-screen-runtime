{
  "schemaVersion": "1.1",
  "kind": "screen",
  "id": "sub-c",
  "metadata": {
    "title": "Synthetic sub-c",
    "source": {
      "type": "hand-authored"
    },
    "size": {
      "width": 150,
      "height": 60
    }
  },
  "macros": [
    {
      "name": "D",
      "default": "SYN:D000"
    }
  ],
  "root": {
    "id": "sub-c-root",
    "type": "absolute-canvas",
    "props": {
      "width": 150,
      "height": 60
    },
    "geometry": {
      "x": 0,
      "y": 0,
      "width": 150,
      "height": 60
    },
    "children": [
      {
        "id": "sub-c-frame",
        "type": "rectangle",
        "props": {
          "lineColor": {
            "$role": "Text",
            "fallback": "#88ad8a",
            "fallbackDark": "#75572d"
          },
          "lineWidth": 1,
          "fill": false
        },
        "geometry": {
          "x": 0,
          "y": 0,
          "width": 150,
          "height": 60
        }
      },
      {
        "id": "sub-c-value",
        "type": "pv-label",
        "props": {
          "pv": "${D}:VAL",
          "foregroundColor": {
            "$role": "Text",
            "fallback": "#dcc176",
            "fallbackDark": "#c7e319"
          }
        },
        "geometry": {
          "x": 4,
          "y": 4,
          "width": 100,
          "height": 22
        }
      },
      {
        "id": "sub-c-led",
        "type": "pv-led",
        "props": {
          "pv": "${D}:STAT",
          "onColor": {
            "$role": "On",
            "fallback": "#4c7ccd",
            "fallbackDark": "#29e313"
          },
          "offColor": {
            "$role": "Grid",
            "fallback": "#21a044",
            "fallbackDark": "#7293b9"
          }
        },
        "geometry": {
          "x": 110,
          "y": 4,
          "width": 22,
          "height": 22
        }
      },
      {
        "id": "sub-c-tag",
        "type": "text-label",
        "props": {
          "text": "SUB-C",
          "foregroundColor": {
            "$role": "Text",
            "fallback": "#c88721",
            "fallbackDark": "#dc2c0a"
          },
          "fontSize": 11
        },
        "geometry": {
          "x": 4,
          "y": 32,
          "width": 140,
          "height": 20
        }
      }
    ]
  }
}
